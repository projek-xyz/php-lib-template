{
    "name": "@projek-xyz/template",
    "private": true,
    "version": "0.6.0",
    "author": "Fery Wardiyanto <ferywardiyanto@gmail.com>",
    "repository": "github:projek-xyz/template",
    "scripts": {
        "prepare": "simple-git-hooks",
        "release": "commit-and-tag-version -s"
    },
    "allowScripts": {
        "simple-git-hooks@2.14.0": true
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "commit-and-tag-version": "^13.2.1",
        "lint-staged": "^17.6.0",
        "simple-git-hooks": "2.14.0"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "commit-and-tag-version": {},
    "simple-git-hooks": {
        "commit-msg": "npx commitlint --edit $1",
        "pre-commit": "npx lint-staged --allow-empty"
    },
    "lint-staged": {
        "*.php": [
            "sh -c 'composer format -- \"$@\"; rc=$?; [ \"$rc\" -ge 0 ]' --"
        ]
    }
}

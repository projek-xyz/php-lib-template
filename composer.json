{
    "name": "projek-xyz/template",
    "description": "Project Template",
    "keywords": ["project", "template"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fery Wardiyanto",
            "email": "ferywardiyanto@gmail.com"
        }
    ],
    "support": {
        "source": "https://github.com/projek-xyz/php-lib-template"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/feryardiant"
        }
    ],
    "scripts": {
        "post-create-project-cmd": [
            "@php scripts/init.php"
        ],
        "format": "phpcbf --standard=PSR12 src scripts",
        "lint": "phpcs --standard=PSR12 src scripts -p -n",
        "spec": "kahlan --config=tests/config.php",
        "test": [
            "@lint",
            "@spec"
        ]
    },
    "autoload": {
        "psr-4": {
            "Projek\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stubs\\": "tests/stub"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "kahlan/kahlan": "^6.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
